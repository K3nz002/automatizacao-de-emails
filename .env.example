# =============================================
# Configurações da API do Resend
# =============================================
# Obtenha sua chave em: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail remetente verificado no Resend (deve ser de um domínio autenticado)
FROM_EMAIL=Politize <noreply@seudominio.com>

# =============================================
# Configurações do Google Sheets
# =============================================
# ID da planilha do Google Sheets (encontrado na URL: .../spreadsheets/d/SPREADSHEET_ID/...)
SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# Nome da aba/worksheet onde estão os destinatários
SHEET_NAME=Destinatários

# Caminho para o arquivo JSON de credenciais da Service Account do Google
# Baixe em: Google Cloud Console → IAM & Admin → Service Accounts → Keys
GOOGLE_CREDENTIALS_PATH=credentials.json

# =============================================
# Configurações do E-mail
# =============================================
# Assunto padrão do e-mail (pode ser sobrescrito por campanha)
EMAIL_SUBJECT=Conheça o Politize — Educação Política para sua Escola

# =============================================
# Configurações de Comportamento
# =============================================
# Intervalo em segundos entre cada envio (para evitar rate limiting)
SEND_INTERVAL_SECONDS=1

# Modo de teste: se True, não envia e-mails de verdade (apenas loga)
DRY_RUN=False
